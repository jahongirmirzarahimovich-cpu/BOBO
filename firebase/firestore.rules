rules_version = '2';
// Bobo: ma'lumotlarni faqat do'kon akkaunti o'qiy va yoza oladi.
// DOKON_EMAIL o'rniga Firebase Authentication'da yaratgan email manzilingizni yozing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'DOKON_EMAIL';
    }
  }
}
